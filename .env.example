# Turbo Capture Service configuration.
# docker compose reads this file (env_file: .env): cp .env.example .env
# Every value is validated at start-up; an invalid value stops the service.

# --- Server -----------------------------------------------------------------
PORT=3001
NODE_ENV=production

# CORS: comma-separated allowed origins. Empty or * allows any origin.
ALLOWED_ORIGINS=https://yourdomain.com

# Reverse proxies in front of the service. Default false: X-Forwarded-For is
# ignored and the rate limit keys on the TCP peer address. Behind proxies set
# the number of hops you control, e.g. 1 for a single nginx or AWS ALB,
# 2 for CloudFront -> ALB. Or list the proxy addresses/CIDRs. Never "true".
TRUST_PROXY=false

# --- Limits -----------------------------------------------------------------
# Free-tier requests per client IP per minute (default 3, or 1 with x402 on).
#RATE_LIMIT_PER_MINUTE=3
# Requests carrying an x402 payment header, per client IP per minute.
PAID_RATE_LIMIT_PER_MINUTE=30
# Captures that may run at once (each is a full Chrome, ~300-500 MB).
MAX_CONCURRENT_CAPTURES=2
# Requests that may wait for a slot; beyond this the service answers 503.
MAX_QUEUE=4
# How long a request may wait in the queue before a 503.
QUEUE_TIMEOUT_MS=30000
# Hard deadline for one capture: launch, navigation, waits, scroll, screenshot.
CAPTURE_TIMEOUT_MS=60000
# Upper bound for page navigation (also capped by the remaining deadline).
NAVIGATION_TIMEOUT_MS=30000
# Screenshots are clipped to this many pixels high...
MAX_SCREENSHOT_HEIGHT=16384
# ...and to this many pixels in total (width x height).
MAX_SCREENSHOT_PIXELS=25000000
# Encoded PNG size cap in bytes; larger results get 422.
MAX_PNG_BYTES=26214400
# Lazy-load scrolling: at most this many steps / this long.
SCROLL_MAX_STEPS=40
SCROLL_MAX_MS=10000
# Bytes a single capture may receive from upstream servers before its
# connections are cut.
MAX_EGRESS_BYTES=209715200

# --- DNS --------------------------------------------------------------------
# c-ares resolver (DNS only; /etc/hosts is not consulted). Per-lookup bound,
# attempts, and per-capture lookups in flight / waiting.
DNS_TIMEOUT_MS=5000
DNS_TRIES=2
DNS_MAX_CONCURRENT=6
DNS_MAX_QUEUE=64
# Lookup bound for the top-level URL pre-check.
PRECHECK_DNS_TIMEOUT_MS=3000

# --- Egress policy ----------------------------------------------------------
# Destination ports Chrome may connect to ("*" = any port).
ALLOWED_PORTS=80,443,8080,8443
# Extra CIDRs to refuse on top of the built-in non-public ranges, e.g. your
# own public IPs / load balancers / NAT gateways.
#BLOCKED_CIDRS=203.0.113.10/32,2001:db8:1234::/48

# --- Chrome -----------------------------------------------------------------
# Keep the Chrome sandbox on. It needs the seccomp profile in seccomp/chrome.json
# (docker-compose.yml applies it). Only set false where a custom seccomp
# profile cannot be used; see README "Chrome sandbox".
CHROME_SANDBOX=true

# --- x402 payments (optional) -----------------------------------------------
# When enabled, clients over the free-tier rate limit get 402 Payment Required
# and can pay per capture. The service refuses to start if enabled without a
# valid X_402_WALLET_ADDRESS and X_402_FACILITATOR_URL.
ENABLE_X_402=false
# Your EVM wallet that receives USDC (required when ENABLE_X_402=true).
X_402_WALLET_ADDRESS=
# base | base-sepolia | eip155:<chainId>
X_402_NETWORK=base
# Facilitator that verifies and settles payments (required when enabled, https).
# It must be an x402 v2 facilitator: check that its /supported endpoint lists
# x402Version 2 for X_402_NETWORK before enabling payments. No default.
X_402_FACILITATOR_URL=
# Price per capture (USD).
X_402_PRICE='$0.01'
