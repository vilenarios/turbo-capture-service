# Server Configuration
PORT=3001

# CORS - Comma-separated list of allowed origins
# Use * for development, specific domains for production
ALLOWED_ORIGINS=http://localhost:5175,https://yourdomain.com

# Node Environment
NODE_ENV=production

# x402 Payment Configuration
# Enable x402 payments to bypass rate limiting
ENABLE_X_402=false

# Your wallet address to receive payments (Base network)
X_402_WALLET_ADDRESS=0x26B751183814E6BA865c1B65BC00ab4d5501CE8C

# Network to use (base, base-sepolia for testnet)
X_402_NETWORK=base

# Facilitator URL for payment verification
X_402_FACILITATOR_URL=https://facilitator.x402.rs

# Price per screenshot (USD)
X_402_PRICE=$0.01
